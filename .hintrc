{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "backdrop-filter"
        ]
      }
    ],
    "disown-opener": "off",
    "no-inline-styles": "off",
    "axe/text-alternatives": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not chrome <= 116",
    "not ios_saf <= 26.3",
    "not safari <= 26.3",
    "not samsung <= 29",
    "not and_ff <= 147",
    "not firefox <= 148"
  ]
}